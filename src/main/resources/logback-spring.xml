<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for Spring and other framework logs -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Application package logger → console -->
    <logger name="se.sprinto.hakan.springboot2" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Root logger → console (covers Spring framework logs) -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>